# ============================================================================
# 家 · 数字家族档案 —— 部署配置模板
# 使用：复制本文件为 .env，填写 JIA_JWT_SECRET 后执行 docker compose up -d
# ============================================================================

# JWT 签名密钥（必填）：每个客户端/每套部署必须设置不同的随机值
# 生成方式：
#   Linux/macOS:  openssl rand -hex 32
#   Windows PS :  [guid]::NewGuid().ToString('N') + [guid]::NewGuid().ToString('N')
JIA_JWT_SECRET=

# 对外访问端口（默认 8081）。保持默认即可；
# 不要随意改动，除非镜像以 --build-arg VITE_API_URL=... 重新构建过。
JIA_HTTP_PORT=8081
